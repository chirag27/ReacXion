<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext HTTP so the app can reach a local FastAPI backend on the
     LAN (e.g. http://192.168.x.x:8000) during development. Tighten for prod. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
